# Everything here is either rebuilt inside the image, secret, or irrelevant to
# the build. Keeping it out makes the image smaller and the build faster — and
# makes sure .env can never be baked into a published layer.
.env
.env.*
!.env.example

vendor/
node_modules/

storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

.git/
.gitignore
.idea/
.vscode/
tests/
phpunit.xml
README.md
